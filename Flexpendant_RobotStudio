	TASK PERS wobjdata wobj1_panela:=[FALSE,TRUE,"",[[183.283,-182.598,120.756],[0.999921,-7.4902E-06,3.21898E-06,0.0125475]],[[0,0,0],[1,0,0,0]]];
	PERS tooldata pintza_robot:=[TRUE,[[-7.86985,-0.102428,135],[1,0,0,0]],[0.5,[0,0,135],[1,0,0,0],0,0,0]];
	TASK PERS wobjdata wobj1_zinta_plataforma:=[FALSE,TRUE,"",[[446.767,28.8904,102],[0.999986,-0.00517694,6.93539E-05,-0.000799722]],[[0,0,0],[1,0,0,0]]];
	CONST robtarget punto_Z_G:=[[-78.41,30.09,145.79],[0.00432223,0.0074265,0.999906,0.0106932],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST jointtarget Home10:=[[10.6536,8.0281,24.5431,0.627499,56.8245,11.2621],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	VAR num pieza_zenbakia:=0;
	CONST robtarget p20:=[[127.88,178.91,300.76],[0.00368918,0.0140964,-0.999893,-0.00145958],[-1,-1,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget P_gabe:=[[127,178,200],[0.00369772,0.0140686,-0.999893,-0.00146415],[-1,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget P_gabe_C1:=[[177,228,200],[0.00370605,0.0140766,-0.999893,-0.00146401],[-1,0,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget P_gabe_C2:=[[227,178.91,200],[0.00370605,0.0140766,-0.999893,-0.00146401],[-1,0,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget P_gabe_C3:=[[177,128,200.01],[0.00370714,0.0140595,-0.999893,-0.00146419],[-1,0,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
