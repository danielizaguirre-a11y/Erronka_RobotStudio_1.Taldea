	PROC main()

	!Home= 0,0,0,0,90,0 robotan hasierako egoera
	MoveAbsJ Home\NoEOffs, v300, fine, pintza_robot\WObj:=wobj1_panela;
	WHILE PLC_Q4_6 = 1 DO
		!Pintza hasierako egoera
		Reset Zurrpagailua_piztu;
		Set Zurrupagailua_itzali;
		IF PLC_Q4_5 = 1 THEN
			!Bikoitia balin bada ibilbide guztia egin
			pieza3_giratorio;
			Amaiera;
			pieza1_beltza;
			Amaiera;
			pieza2_txuria;
			Amaiera;
			Set Robota_ok;
			WaitTime 2;
			Reset Robota_ok;
		ENDIF
		IF PLC_Q4_4 = 1 THEN
			!Bakoitia balin bada ze pieza aukeratzeko aukera ematen dizu
			TPReadFK pieza_zenbakia, "ze pieza nahi duzu?", "pieza1_beltza", "pieza2_txuria", "pieza3_giratorio", "Piezak_gabe", stEmpty;
		ENDIF
	IF pieza_zenbakia = 4 THEN
		Piezak_gabe;
		Set Robota_ok;
			WaitTime 2;
			Reset Robota_ok;
            pieza_zenbakia := 0;
	ENDIF
	IF pieza_zenbakia = 3 THEN
		!Bakoitia eta aukeratzen baduzu 3.piezaren ibilbidea egingo du
		pieza3_giratorio;
		WaitTime 1;
		Amaiera;
		Set Robota_ok;
			WaitTime 2;
			Reset Robota_ok;
            pieza_zenbakia := 0;

	ENDIF
	IF pieza_zenbakia = 2 THEN
		!Bakoitia eta aukeratzen baduzu 2.piezaren ibilbidea egingo du
		pieza2_txuria;
		WaitTime 1;
		Amaiera;
		Set Robota_ok;
			WaitTime 2;
			Reset Robota_ok;
            pieza_zenbakia := 0;

	ENDIF
	IF pieza_zenbakia = 1 THEN
		!Bakoitia eta aukeratzen baduzu 1.piezaren ibilbidea egingo du
		pieza1_beltza;
		WaitTime 1;
		Amaiera;
		Set Robota_ok;
			WaitTime 2;
			Reset Robota_ok;
            pieza_zenbakia := 0;
	ENDIF
	ENDWHILE
ENDPROC
	PROC pieza2_txuria()
		!2.piezaren agindu guztiak
		MoveL p10, v300, fine, pintza_robot\WObj:=wobj1_panela;
		MoveL Offs(pieza2,0,0,100), v300, fine, pintza_robot\WObj:=wobj1_panela;
		WaitTime 1;
		MoveL pieza2, v300, fine, pintza_robot\WObj:=wobj1_panela;
		Reset Zurrupagailua_itzali;
		Set Zurrpagailua_piztu;
		WaitTime 1;
		MoveL p10, v300, fine, pintza_robot\WObj:=wobj1_panela;
	ENDPROC
	PROC pieza3_giratorio()
		!3.piezaren agindu guztiak
		MoveL p10, v300, fine, pintza_robot\WObj:=wobj1_panela;
		MoveL Offs(pieza3,0,0,100), v300, fine, pintza_robot\WObj:=wobj1_panela;
		WaitTime 1;
		MoveL pieza3, v300, fine, pintza_robot\WObj:=wobj1_panela;
		Reset Zurrupagailua_itzali;
		Set Zurrpagailua_piztu;
		WaitTime 1;
		MoveL p10, v300, fine, pintza_robot\WObj:=wobj1_panela;
	ENDPROC
	PROC pieza1_beltza()
		!1.piezaren agindu guztiak
		MoveL p10, v300, fine, pintza_robot\WObj:=wobj1_panela;
		MoveL Offs(pieza1,0,0,100), v300, fine, pintza_robot\WObj:=wobj1_panela;
		WaitTime 1;
		MoveL pieza1, v300, fine, pintza_robot\WObj:=wobj1_panela;
		Reset Zurrupagailua_itzali;
		Set Zurrpagailua_piztu;
		WaitTime 1;
		MoveL p10, v300, fine, pintza_robot\WObj:=wobj1_panela;
	ENDPROC
	PROC Amaiera()
	!pieza bukaerako plataforman eramango dituen aginduak
	MoveJ punto_Z_G, v300, fine, pintza_robot\WObj:=wobj1_zinta_plataforma;
	MoveJ Offs(Z_kubo_erdia,0,0,100), v300, fine, pintza_robot\WObj:=wobj1_zinta_plataforma;
	MoveL Z_kubo_erdia, v300, fine, pintza_robot\WObj:=wobj1_zinta_plataforma;
		Reset Zurrpagailua_piztu;
		Set Zurrupagailua_itzali;
	ENDPROC
	PROC Piezak_gabe()
		MoveL P_gabe, v300, fine, pintza_robot\WObj:=wobj1_panela;
		MoveC P_gabe_C1, P_gabe_C2, v300, z10, pintza_robot\WObj:=wobj1_panela;
		MoveC P_gabe_C3, P_gabe, v300, z10, pintza_robot\WObj:=wobj1_panela;
	ENDPROC
ENDMODULE
